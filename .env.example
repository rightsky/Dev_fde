# 복사해서 .env 로 저장한 뒤 값을 바꾸세요. .env 는 저장소에 올리지 않습니다.

# PostgreSQL 비밀번호 (URL 에 들어가므로 영문·숫자만 권장)
POSTGRES_PASSWORD=change-me-db-password

# 로그인 토큰 서명 키. 예: openssl rand -hex 32
FDE_SECRET_KEY=change-me-64-hex-characters

# 최초 기동 때 만들어지는 관리자 계정 (이후 변경은 화면의 '비밀번호 변경')
FDE_ADMIN_USERNAME=admin
FDE_ADMIN_PASSWORD=change-me-admin-password

# 발행 IRI 의 기준 주소 — 기관 카탈로그 도메인으로 바꾸세요
FDE_BASE_IRI=https://catalog.molit.go.kr

# 접속 포트, 파일당 업로드 상한(MB), 시나리오 기관 5곳 시드 여부
FDE_PORT=8080
FDE_MAX_UPLOAD_MB=50
FDE_SEED_DEMO_ORGS=true

# AI 초안 제안 (STEP 3 서술형 칸). 비워 두면 기능이 꺼집니다. 개인정보 의심 컬럼의 값은 모델에 보내지 않습니다.
# 키는 https://platform.claude.com 에서 발급합니다. 외부(Anthropic)로 데이터셋 요약·컬럼 통계가 전송되므로 기관 보안정책을 확인하세요.
FDE_ANTHROPIC_API_KEY=
FDE_AI_MODEL=claude-opus-5-5
